# Copy to .env.local for `next dev`, and to .dev.vars for `npm run cf:preview`. Never commit real values.

# ── Public (safe in the browser; baked in at build time) ─────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Supabase project URL and the anon / publishable key (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key. For local testing Cloudflare documents this always-pass test key:
# 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudinary (Free plan) cloud name, from the Cloudinary dashboard. Public: it appears in image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Country calling code (digits only, e.g. the number after "+") added to phone numbers typed without "+".
# Leave empty to require customers to type the full international number.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=

# ── Server-only secrets (Cloudflare Worker secrets in production) ────
# Supabase service_role key. Bypasses RLS: NEVER expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Turnstile secret key. Cloudflare's documented always-pass test secret for local testing:
# 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Any long random string; used to hash client IPs before they are stored.
IP_HASH_SALT=

# Cloudinary API key + secret (Programmable Media -> API Keys). The secret signs uploads on the server only.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Telegram alert for new orders (free). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
